# =============================================================================
# XSigma Bazel Workspace Configuration
# =============================================================================
# This file defines the workspace and manages third-party dependencies
# Equivalent to CMakeLists.txt + ThirdParty/CMakeLists.txt
# =============================================================================

workspace(name = "xsigma")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
load("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository", "new_git_repository")

# =============================================================================
# Bazel Skylib - Utility functions for Bazel
# =============================================================================
http_archive(
    name = "bazel_skylib",
    urls = [
        "https://mirror.bazel.build/github.com/bazelbuild/bazel-skylib/releases/download/1.4.2/bazel-skylib-1.4.2.tar.gz",
        "https://github.com/bazelbuild/bazel-skylib/releases/download/1.4.2/bazel-skylib-1.4.2.tar.gz",
    ],
)

load("@bazel_skylib//:workspace.bzl", "bazel_skylib_workspace")
bazel_skylib_workspace()

load("//bazel:svml_configure.bzl", "svml_configure")

# Host compile probe — mirrors Vectorization Cmake/utils.cmake native SVML check (per SIMD tier).
svml_configure(name = "vectorization_svml_autodetect")

load("//bazel:sleef_configure.bzl", "sleef_configure")

# Locates CMake-built SLEEF artifacts for --config=sleef, or generates a
# target that fails with an actionable message if none are found. See
# bazel/sleef_configure.bzl for why this isn't a hermetic from-source build.
sleef_configure(name = "sleef_cmake")

load("//bazel:openmp_configure.bzl", "openmp_configure")

# Host compile probe — mirrors Library/Parallel/Cmake/openmp.cmake's find_package(OpenMP).
openmp_configure(name = "parallel_openmp")

# =============================================================================
# Third-Party Dependencies
# =============================================================================

# -----------------------------------------------------------------------------
# fmt — vendored ThirdParty/fmt (must match CMake / spdlog; same tree as Library/Logging)
# -----------------------------------------------------------------------------
new_local_repository(
    name = "fmt",
    path = "ThirdParty/fmt",
    build_file = "//ThirdParty:fmt.BUILD",
)

# -----------------------------------------------------------------------------
# cpuinfo - CPU feature detection library (using local copy)
# -----------------------------------------------------------------------------
# Note: Using local ThirdParty/cpuinfo instead of downloading

# -----------------------------------------------------------------------------
# magic_enum - Static reflection for enums
# -----------------------------------------------------------------------------
http_archive(
    name = "magic_enum",
    build_file = "//ThirdParty:magic_enum.BUILD",
    strip_prefix = "magic_enum-0.9.5",
    urls = [
        "https://github.com/Neargye/magic_enum/archive/refs/tags/v0.9.5.tar.gz",
    ],
)

# -----------------------------------------------------------------------------
# mimalloc - Microsoft's high-performance memory allocator
# -----------------------------------------------------------------------------
http_archive(
    name = "mimalloc",
    build_file = "//ThirdParty:mimalloc.BUILD",
    strip_prefix = "mimalloc-2.1.2",
    urls = [
        "https://github.com/microsoft/mimalloc/archive/refs/tags/v2.1.2.tar.gz",
    ],
)

# -----------------------------------------------------------------------------
# Google Test - Unit testing framework
# -----------------------------------------------------------------------------
# Use the vendored ThirdParty/googletest submodule (ships its own BUILD.bazel
# with :gtest / :gtest_main targets) instead of fetching a separately pinned
# version over the network. This is the same source CMake builds from
# (ThirdParty/googletest via add_subdirectory), so both build systems compile
# the exact same googletest commit -- no more version drift between them.
# glog's own Bazel build references @googletest, which bzlmod already
# provides via the `googletest` bazel_dep in MODULE.bazel; no WORKSPACE alias
# is needed for that name.
local_repository(
    name = "com_google_googletest",
    path = "ThirdParty/googletest",
)

# -----------------------------------------------------------------------------
# Google Logging (glog) - Logging library (from local ThirdParty directory)
# -----------------------------------------------------------------------------
local_repository(
    name = "glog",
    path = "ThirdParty/glog",
)

# -----------------------------------------------------------------------------
# Loguru - Lightweight C++ logging library (using custom BUILD file)
# -----------------------------------------------------------------------------
# Note: Loguru is a git submodule in ThirdParty/loguru
# We use new_local_repository to provide our own BUILD file without modifying
# the third-party submodule (as per .augment/rules/ThirdParty.md)
new_local_repository(
    name = "loguru",
    path = "ThirdParty/loguru",
    build_file = "//ThirdParty:loguru.BUILD",
)

# -----------------------------------------------------------------------------
# spdlog — fast header-only logging (git submodule ThirdParty/spdlog)
# -----------------------------------------------------------------------------
new_local_repository(
    name = "spdlog",
    path = "ThirdParty/spdlog",
    build_file = "//ThirdParty:spdlog.BUILD",
)

# -----------------------------------------------------------------------------
# Google Benchmark - Microbenchmarking framework
# -----------------------------------------------------------------------------
http_archive(
    name = "com_google_benchmark",
    strip_prefix = "benchmark-1.8.3",
    urls = [
        "https://github.com/google/benchmark/archive/refs/tags/v1.8.3.tar.gz",
    ],
)

# -----------------------------------------------------------------------------
# Kineto - Profiling library (from local ThirdParty directory)
# -----------------------------------------------------------------------------
# Note: Kineto is a git submodule in ThirdParty/kineto
# We use new_local_repository to provide our own BUILD file without modifying
# the third-party submodule (as per .augment/rules/ThirdParty.md)
new_local_repository(
    name = "kineto",
    path = "ThirdParty/kineto",
    build_file = "//ThirdParty:kineto.BUILD",
)

# -----------------------------------------------------------------------------
# Profiler — standalone product (https://github.com/KhwarizmiAnalytix/Profiler)
# -----------------------------------------------------------------------------
# Git submodule ThirdParty/Profiler. Overlay BUILD so we do not edit the
# vendored tree; host //bazel flags are referenced as @xsigma//bazel:*.
load("//bazel:profiler_repository.bzl", "local_profiler_repository")

local_profiler_repository(
    name = "profiler",
    path = "ThirdParty/Profiler",
    build_file = "//ThirdParty:profiler.BUILD",
)

# -----------------------------------------------------------------------------
# Intel ITT API (ittnotify) — VTune instrumentation, used by Profiler's ITT backend
# -----------------------------------------------------------------------------
# Note: ittapi is a git submodule in ThirdParty/ittapi (v3.27.0)
# We use new_local_repository to provide our own BUILD file without modifying
# the third-party submodule (as per .augment/rules/ThirdParty.md)
new_local_repository(
    name = "ittapi",
    path = "ThirdParty/ittapi",
    build_file = "//ThirdParty:ittapi.BUILD",
)

# -----------------------------------------------------------------------------
# Intel SVML — Short Vector Math Library (optional, vendored binaries)
# Link when autodetect says compiler needs it (see //bazel:svml_configure.bzl) or when
# --define=vectorization_enable_svml=true; opt out with vectorization_enable_svml=false.
# Mirrors CMake FindSVML.cmake + VECTORIZATION_ENABLE_SVML logic.
# -----------------------------------------------------------------------------
new_local_repository(
    name = "svml",
    path = "ThirdParty/svml",
    build_file = "//ThirdParty:svml.BUILD",
)

# =============================================================================
# Platform-Specific Dependencies
# =============================================================================

# -----------------------------------------------------------------------------
# CUDA Support (optional)
# -----------------------------------------------------------------------------
# Resolves CUDA toolkit from CUDA_PATH / CUDA_HOME, or default install paths
# (Windows: Program Files/NVIDIA GPU Computing Toolkit/CUDA/v*; Linux: /usr/local/cuda, /opt/cuda).
load("//bazel:cuda_configure.bzl", "cuda_configure")

cuda_configure(name = "local_config_cuda")

# -----------------------------------------------------------------------------
# HIP/ROCm Support (optional, Unix-only)
# -----------------------------------------------------------------------------
# Resolves ROCm toolkit from ROCM_PATH / HIP_PATH, or the default /opt/rocm install path.
load("//bazel:hip_configure.bzl", "hip_configure")

hip_configure(name = "local_config_hip")

# -----------------------------------------------------------------------------
# Intel MKL Support (optional)
# -----------------------------------------------------------------------------
# Uncomment if MKL is enabled
# local_repository(
#     name = "mkl",
#     path = "/opt/intel/mkl",
# )

# -----------------------------------------------------------------------------
# Intel TBB Support (optional)
# -----------------------------------------------------------------------------
http_archive(
    name = "tbb",
    build_file = "//ThirdParty:tbb.BUILD",
    strip_prefix = "oneTBB-2021.10.0",
    urls = [
        "https://github.com/oneapi-src/oneTBB/archive/refs/tags/v2021.10.0.tar.gz",
    ],
)
