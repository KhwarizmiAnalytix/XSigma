# Bazel overlay for the Logging third-party submodule (ThirdParty/Logging,
# https://github.com/KhwarizmiAnalytix/Logging). Used via new_local_repository in
# WORKSPACE.bazel as @logging. Include root is the repo root (no Logging/logging/ nesting).
# Mirrors the CMake build in ThirdParty/Logging/CMakeLists.txt.
#
# Nested backends (loguru / glog / spdlog / magic_enum) are private to this
# overlay — XSigma does not register them as WORKSPACE repos.
load("@xsigma//bazel:logging.bzl", "logging_copts", "logging_defines", "logging_linkopts")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "logging_hdrs",
    srcs = glob(
        [
            "*.h",
            "common/*.h",
            "util/*.h",
            "logger/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "logging_srcs",
    srcs = glob(
        [
            "util/*.cpp",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "loguru",
    srcs = ["ThirdParty/loguru/loguru.cpp"],
    hdrs = ["ThirdParty/loguru/loguru.hpp"],
    copts = select({
        "@platforms//os:windows": [
            "/W0",
            "/std:c++17",
        ],
        "//conditions:default": [
            "-w",
            "-std=c++17",
            "-fPIC",
        ],
    }),
    defines = ["LOGURU_WITH_STREAMS=1"],
    includes = ["ThirdParty/loguru"],
    linkopts = select({
        "@platforms//os:windows": [],
        "@platforms//os:macos": ["-lpthread"],
        "//conditions:default": ["-lpthread", "-ldl"],
    }),
    linkstatic = True,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "spdlog",
    hdrs = glob(["ThirdParty/spdlog/include/**/*.h"]),
    defines = ["SPDLOG_FMT_EXTERNAL_HO"],
    includes = ["ThirdParty/spdlog/include"],
    deps = ["@fmt//:fmt"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "magic_enum",
    hdrs = glob(["ThirdParty/magic_enum/include/**/*.hpp"]),
    includes = ["ThirdParty/magic_enum/include"],
    visibility = ["//visibility:private"],
)

# glog config.h is generated by CMake; Bazel substitutes #cmakedefine away so
# the default #ifdefs in the template are used (WITH_GFLAGS remains off).
genrule(
    name = "glog_config",
    srcs = ["ThirdParty/glog/src/config.h.cmake.in"],
    outs = ["glog_internal/config.h"],
    cmd = "python3 -c 'import sys; d=open(sys.argv[1]).read().replace(\"#cmakedefine\",\"//cmakedefine\"); open(sys.argv[2],\"w\").write(d)' $(SRCS) $(OUTS)",
)

cc_library(
    name = "glog",
    srcs = [
        ":glog_config",
        "ThirdParty/glog/src/demangle.cc",
        "ThirdParty/glog/src/flags.cc",
        "ThirdParty/glog/src/logging.cc",
        "ThirdParty/glog/src/raw_logging.cc",
        "ThirdParty/glog/src/signalhandler.cc",
        "ThirdParty/glog/src/stacktrace.cc",
        "ThirdParty/glog/src/symbolize.cc",
        "ThirdParty/glog/src/utilities.cc",
        "ThirdParty/glog/src/vlog_is_on.cc",
    ] + select({
        "@platforms//os:windows": [
            "ThirdParty/glog/src/windows/port.cc",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob(["ThirdParty/glog/src/glog/*.h"], allow_empty = True),
    textual_hdrs = glob(
        [
            "ThirdParty/glog/src/*.h",
            "ThirdParty/glog/src/**/*-inl.h",
            "ThirdParty/glog/src/base/*.h",
            "ThirdParty/glog/src/windows/*.h",
        ],
        allow_empty = True,
    ),
    copts = select({
        "@platforms//os:windows": [
            "/W0",
            "-DGLOG_NO_ABBREVIATED_SEVERITIES",
            "-DGLOG_USE_WINDOWS_PORT",
        ],
        "@platforms//os:macos": [
            "-w",
            "-DHAVE_DLADDR",
            "-DHAVE_MODE_T",
            "-DHAVE_SSIZE_T",
            "-DHAVE_SYS_TYPES_H",
            "-DHAVE_SYS_TIME_H",
            "-DHAVE_SYS_UTSNAME_H",
            "-DHAVE_SYS_SYSCALL_H",
            "-DHAVE_UNISTD_H",
            "-DHAVE_UNWIND",
            "-DHAVE_PREAD",
            "-DHAVE_SIGACTION",
            "-DHAVE_POSIX_FADVISE",
        ],
        "//conditions:default": [
            "-w",
            "-DHAVE_EXECINFO_H",
            "-DHAVE_LINK_H",
            "-DHAVE_MODE_T",
            "-DHAVE_SSIZE_T",
            "-DHAVE_SYS_TYPES_H",
            "-DHAVE_SYS_TIME_H",
            "-DHAVE_SYS_UTSNAME_H",
            "-DHAVE_SYS_SYSCALL_H",
            "-DHAVE_UNISTD_H",
            "-DHAVE_UNWIND",
            "-DHAVE_PREAD",
            "-DHAVE_SIGACTION",
            "-DHAVE_POSIX_FADVISE",
        ],
    }),
    defines = select({
        "@platforms//os:windows": [
            "GLOG_DEPRECATED=__declspec(deprecated)",
            "GLOG_EXPORT=",
            "GLOG_NO_ABBREVIATED_SEVERITIES",
            "GLOG_NO_EXPORT=",
        ],
        "//conditions:default": [
            "GLOG_DEPRECATED=__attribute__((deprecated))",
            "GLOG_EXPORT=__attribute__((visibility(\\\"default\\\")))",
            "GLOG_NO_EXPORT=__attribute__((visibility(\\\"default\\\")))",
        ],
    }),
    includes = [
        "ThirdParty/glog/src",
        "glog_internal",
    ],
    linkopts = select({
        "@platforms//os:windows": ["dbghelp.lib"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "logging_lib",
    srcs = [
        ":logging_srcs",
        "logger/back_trace.cpp",
        "logger/logger.cpp",
    ],
    hdrs = [":logging_hdrs"],
    copts = logging_copts(),
    defines = logging_defines() + select({
        "@xsigma//bazel:shared_libs": ["LOGGING_SHARED_DEFINE"],
        "//conditions:default": ["LOGGING_STATIC_DEFINE"],
    }),
    local_defines = select({
        "@xsigma//bazel:shared_libs": ["LOGGING_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    includes = [".", "logger"],
    linkopts = logging_linkopts() + select({
        "@platforms//os:windows": ["dbghelp.lib"],
        "//conditions:default": [],
    }),
    linkstatic = select({
        "@xsigma//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = [
        "@fmt//:fmt",
    ] + select({
        "@xsigma//bazel:disable_magic_enum": [],
        "//conditions:default": [":magic_enum"],
    }) + select({
        "@xsigma//bazel:logging_glog": [":glog"],
        "@xsigma//bazel:logging_loguru": [":loguru"],
        "@xsigma//bazel:logging_native": [],
        "@xsigma//bazel:logging_spdlog": [":spdlog"],
        "//conditions:default": [":loguru"],
    }),
    alwayslink = False,
)

cc_library(
    name = "Logging",
    deps = [":logging_lib"],
    visibility = ["//visibility:public"],
)
