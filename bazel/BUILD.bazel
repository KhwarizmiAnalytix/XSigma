# =============================================================================
# XSigma Bazel Configuration Settings
# =============================================================================
# Config settings for conditional compilation
# Starlark --define keys mirror CMake cache names: lowercase MODULE_* (e.g. core_enable_mkl,
# memory_enable_cuda, parallel_backend, parallel_enable_openmp, vectorization_type).
# =============================================================================

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":vectorization_settings.bzl", "define_vectorization_platform_settings")

package(default_visibility = ["//visibility:public"])

# Export the helper functions
exports_files([
    "xsigma.bzl",
    "embed_metal_kernel.py",
])

# =============================================================================
# Library Type Configuration
# =============================================================================

config_setting(
    name = "shared_libs",
    define_values = {"build_shared_libs": "true"},
)

# =============================================================================
# GPU Backend Configuration (Memory)
# =============================================================================

config_setting(
    name = "enable_cuda",
    define_values = {"memory_enable_cuda": "true"},
)

config_setting(
    name = "enable_hip",
    define_values = {"memory_enable_hip": "true"},
)

config_setting(
    name = "enable_metal",
    define_values = {"memory_enable_metal": "true"},
)

# Vectorization's own GPU backend (VECTORIZATION_GPU_BACKEND) is a CMake cache variable
# independent of Memory's MEMORY_GPU_BACKEND -- Scripts/setup.py's --gpu_backend= flag sets
# both together for convenience, but they're two separate CMake options (a raw CMake
# invocation could set them differently), so these get their own vectorization_enable_*
# config_settings rather than reusing enable_cuda/enable_hip/enable_metal above (which are
# keyed on memory_enable_*).
config_setting(
    name = "vectorization_enable_cuda",
    define_values = {"vectorization_enable_cuda": "true"},
)

config_setting(
    name = "vectorization_enable_hip",
    define_values = {"vectorization_enable_hip": "true"},
)

config_setting(
    name = "vectorization_enable_metal",
    define_values = {"vectorization_enable_metal": "true"},
)

# =============================================================================
# Parallel Computing Configuration
# =============================================================================

config_setting(
    name = "enable_openmp",
    define_values = {"parallel_enable_openmp": "true"},
)

# CMake PARALLEL_BACKEND=openmp|tbb — drives Parallel SMP backend (default std via .bazelrc).
config_setting(
    name = "parallel_backend_openmp",
    define_values = {"parallel_backend": "openmp"},
)

config_setting(
    name = "parallel_backend_tbb",
    define_values = {"parallel_backend": "tbb"},
)

config_setting(
    name = "memory_enable_tbb",
    define_values = {"memory_enable_tbb": "true"},
)

config_setting(
    name = "parallel_enable_tbb",
    define_values = {"parallel_enable_tbb": "true"},
)

# =============================================================================
# Math Library Configuration (Core)
# =============================================================================

config_setting(
    name = "enable_mkl",
    define_values = {"core_enable_mkl": "true"},
)

# =============================================================================
# Memory Allocator Configuration
# =============================================================================

config_setting(
    name = "enable_mimalloc",
    define_values = {"memory_enable_mimalloc": "true"},
)

# Opt-out when CMake-equivalent default is ON (mimalloc, Sobol 1111)
config_setting(
    name = "disable_mimalloc",
    define_values = {"memory_enable_mimalloc": "false"},
)

# =============================================================================
# Logging code-generation switches. Their names mirror the corresponding
# CMake cache variables; unset values retain CMake's defaults.
config_setting(
    name = "disable_logging_cxa_demangle",
    define_values = {"logging_enable_cxa_demangle": "false"},
)

config_setting(
    name = "logging_portable_float_format",
    define_values = {"logging_enable_portable_float_format": "true"},
)

config_setting(
    name = "logging_std_format",
    define_values = {"logging_format_use_std": "true"},
)

config_setting(
    name = "logging_default_log_fatal",
    define_values = {"logging_default_exception_mode": "log_fatal"},
)

# Compiler-wrapper caching (ccache/sccache/buildcache) is CMake-only.
# Configure Bazel caching via remote execution or toolchains instead.

# =============================================================================
# Algorithm Configuration (Core)
# =============================================================================

config_setting(
    name = "lu_pivoting",
    define_values = {"core_lu_pivoting": "true"},
)

config_setting(
    name = "sobol_1111",
    define_values = {"core_sobol_1111": "true"},
)

config_setting(
    name = "disable_sobol_1111",
    define_values = {"core_sobol_1111": "false"},
)

# =============================================================================
# Enzyme AD (matches CMake CORE_ENABLE_ENZYME / XSIGMA_HAS_ENZYME)
# =============================================================================

config_setting(
    name = "enable_enzyme",
    define_values = {"core_enable_enzyme": "true"},
)

# =============================================================================
# Compression Configuration (CORE_HAS_COMPRESSION / CORE_COMPRESSION_TYPE_SNAPPY)
# =============================================================================

config_setting(
    name = "enable_compression",
    define_values = {"core_enable_compression": "true"},
)

# Matches CMake: CORE_ENABLE_COMPRESSION=ON + CORE_COMPRESSION_TYPE=SNAPPY
config_setting(
    name = "compression_snappy",
    define_values = {
        "core_enable_compression": "true",
        "core_compression_type": "snappy",
    },
)

# Alias used by core.bzl (enable_compression_snappy mirrors compression_snappy)
config_setting(
    name = "enable_compression_snappy",
    define_values = {
        "core_enable_compression": "true",
        "core_compression_type": "snappy",
    },
)

# =============================================================================
# NUMA Configuration (MEMORY_HAS_NUMA — Unix only)
# =============================================================================

config_setting(
    name = "enable_numa",
    define_values = {"memory_enable_numa": "true"},
)

# =============================================================================
# memkind Configuration (MEMORY_HAS_MEMKIND — Linux only)
# =============================================================================

config_setting(
    name = "enable_memkind",
    define_values = {"memory_enable_memkind": "true"},
)

# =============================================================================
# Optional Project Feature Configuration
# =============================================================================

config_setting(
    name = "enable_svml",
    define_values = {"vectorization_enable_svml": "true"},
)

config_setting(
    name = "enable_accelerate",
    define_values = {"vectorization_enable_accelerate": "true"},
)

# Vectorization's own MKL VML backend -- a distinct CMake option (VECTORIZATION_ENABLE_MKL)
# from Core's CORE_ENABLE_MKL (//bazel:enable_mkl above, keyed on core_enable_mkl); don't
# conflate the two, they're independently toggled in CMake.
config_setting(
    name = "vectorization_enable_mkl",
    define_values = {"vectorization_enable_mkl": "true"},
)

# vectorization_enable_mkl AND x86_64 combined -- CMake disables VECTORIZATION_ENABLE_MKL
# outright on non-x86_64 (CMakeLists.txt:436-438: "only supported on x86_64; disabling").
config_setting(
    name = "vectorization_mkl_x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
    define_values = {"vectorization_enable_mkl": "true"},
)

# enable_accelerate AND macOS combined -- Accelerate.framework is only linked on Apple
# platforms (CMakeLists.txt:784: `if(VECTORIZATION_ENABLE_ACCELERATE AND APPLE)`); the
# VECTORIZATION_HAS_ACCELERATE compile definition itself is platform-independent (see
# vectorization_defines() in bazel/vectorization.bzl).
config_setting(
    name = "vec_accelerate_macos",
    constraint_values = ["@platforms//os:osx"],
    define_values = {"vectorization_enable_accelerate": "true"},
)

config_setting(
    name = "disable_svml",
    define_values = {"vectorization_enable_svml": "false"},
)

config_setting(
    name = "enable_sleef",
    define_values = {"vectorization_enable_sleef": "true"},
)

config_setting(
    name = "disable_sleef",
    define_values = {"vectorization_enable_sleef": "false"},
)

# Vectorization SIMD tier (default in vectorization.bzl = AVX2 when unset)
config_setting(
    name = "vectorization_type_no",
    define_values = {"vectorization_type": "no"},
)

config_setting(
    name = "vectorization_type_sse",
    define_values = {"vectorization_type": "sse"},
)

config_setting(
    name = "vectorization_type_avx",
    define_values = {"vectorization_type": "avx"},
)

config_setting(
    name = "vectorization_type_avx2",
    define_values = {"vectorization_type": "avx2"},
)

config_setting(
    name = "vectorization_type_avx512",
    define_values = {"vectorization_type": "avx512"},
)

config_setting(
    name = "vectorization_type_neon",
    define_values = {"vectorization_type": "neon"},
)

config_setting(
    name = "vectorization_type_sve",
    define_values = {"vectorization_type": "sve"},
)

# Host CPU selectors for default SIMD choice when vectorization_type is unset:
# x86_64 -> AVX2, aarch64 -> NEON.
config_setting(
    name = "cpu_x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "cpu_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# vectorization_type_X_aarch64: same define_values as vectorization_type_X, plus the
# aarch64 constraint -- a strict superset of both "cpu_aarch64" and the bare
# "vectorization_type_X" setting. Bazel's select() ambiguity rule allows multiple matches
# when one is unambiguously more specialized (a strict superset of the others); without
# these, an explicit --define=vectorization_type=X on an aarch64 host is ambiguous against
# "cpu_aarch64" (both match, neither is a superset of the other) for every tier whose
# defines differ from NEON's -- i.e. every tier except neon itself, which only avoids the
# error by coincidence (its define list happens to equal cpu_aarch64's). vectorization.bzl's
# vectorization_defines() pairs each bare setting with its _aarch64 counterpart via
# selects.with_or() so the explicit choice always wins over the arch-based default.
config_setting(
    name = "vectorization_type_no_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "no"},
)

config_setting(
    name = "vectorization_type_sse_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "sse"},
)

config_setting(
    name = "vectorization_type_avx_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "avx"},
)

config_setting(
    name = "vectorization_type_avx2_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "avx2"},
)

config_setting(
    name = "vectorization_type_avx512_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "avx512"},
)

config_setting(
    name = "vectorization_type_neon_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "neon"},
)

config_setting(
    name = "vectorization_type_sve_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    define_values = {"vectorization_type": "sve"},
)

config_setting(
    name = "enable_rocm",
    define_values = {"core_enable_rocm": "true"},
)

config_setting(
    name = "enable_experimental",
    define_values = {"core_enable_experimental": "true"},
)

# =============================================================================
# Testing Configuration (project-wide; mirrors *ENABLE_GTEST / *ENABLE_BENCHMARK)
# =============================================================================

config_setting(
    name = "enable_gtest",
    define_values = {"enable_gtest": "true"},
)

# CMake: CORE_ENABLE_GTEST / VECTORIZATION_ENABLE_GTEST default ON; opt out explicitly.
config_setting(
    name = "disable_gtest",
    define_values = {"enable_gtest": "false"},
)

config_setting(
    name = "enable_benchmark",
    define_values = {"enable_benchmark": "true"},
)

# CMake: VECTORIZATION_ENABLE_TESTING default ON; opt out with false.
config_setting(
    name = "vectorization_disable_testing",
    define_values = {"vectorization_enable_testing": "false"},
)

# CMake: VECTORIZATION_ENABLE_BENCHMARK default ON; opt out with false.
config_setting(
    name = "vectorization_disable_benchmark",
    define_values = {"vectorization_enable_benchmark": "false"},
)

# VECTORIZATION_PACKET_SIZE — SIMD registers processed per unrolled loop iteration in the
# expression evaluator (CMakeLists.txt:201-215: cache var, default "1", bounded to [1,16]).
# --//bazel:vectorization_packet_size=N (default "1", matching CMake's default).
string_flag(
    name = "vectorization_packet_size",
    build_setting_default = "1",
)

[
    config_setting(
        name = "vectorization_packet_size_%d" % n,
        flag_values = {":vectorization_packet_size": str(n)},
    )
    for n in range(1, 17)
]

# (vectorization_type) × OS — used by //bazel:vectorization.bzl SIMD copts
define_vectorization_platform_settings()
