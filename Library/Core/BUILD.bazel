# =============================================================================
# XSigma Core Library — utilities, intrusive_ptr, compression.
# Memory is //Library/Memory; Logging is @logging (ThirdParty/Logging submodule,
# standalone macro headers per module). Parallel is @parallel; Profiler is @profiler.
# =============================================================================

load("//bazel:core.bzl", "core_copts", "core_defines", "core_enzyme_copts", "core_enzyme_linkopts", "core_linkopts")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "core_hdrs",
    srcs = glob(
        [
            "util/*.h",
            "common/*.h",
            "c17/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "core_srcs",
    srcs = glob(
        [
            "common/*.cpp",
            "util/*.cpp",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "core_lib",
    srcs = [
        ":core_srcs",
    ] + select({
        "//bazel:compression_snappy": glob(["compression/snappy.cpp"], allow_empty = True),
        "//conditions:default": [],
    }),
    hdrs = [
        ":core_hdrs",
    ] + select({
        "//bazel:compression_snappy": glob(["compression/snappy.h"], allow_empty = True),
        "//conditions:default": [],
    }),
    copts = core_copts() + core_enzyme_copts() + [
        # -I (not the -isystem that @cpuinfo's `includes` generates): Apple clang's
        # driver injects /usr/local/include ahead of -isystem paths, and a stale
        # system cpuinfo.h there would shadow the vendored one (see cpuinfo.BUILD).
        "-Iexternal/cpuinfo/include",
    ],
    defines = core_defines() + select({
        "//bazel:shared_libs": ["XSIGMA_SHARED_DEFINE", "XSIGMA_BUILDING_DLL"],
        "//conditions:default": ["XSIGMA_STATIC_DEFINE"],
    }),
    includes = [
        ".",
        "Testing",
    ],
    linkopts = core_linkopts() + core_enzyme_linkopts() + select({
        "@platforms//os:windows": [],
        "@platforms//os:macos": ["-framework Security"],
        "//conditions:default": ["-lpthread", "-ldl", "-lrt"],
    }),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = [
        "@fmt//:fmt",
        "@logging//:Logging",
        "//Library/Memory:memory_lib",
        "@cpuinfo//:cpuinfo",
    ],
    alwayslink = False,
    visibility = [
        "//Library/Core:__pkg__",
    ],
)

cc_library(
    name = "Core",
    deps = [
        ":core_lib",
    ],
    visibility = ["//visibility:public"],
)
