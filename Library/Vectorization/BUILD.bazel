# Library/Vectorization — SIMD layer (headers under ., backends under backend/).
# Include roots match CMake: "backend/simd.h", "backend/cpu/avx/float/simd.h", etc.
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load(
    "//bazel:vectorization.bzl",
    "vectorization_copts",
    "vectorization_defines",
    "vectorization_gpu_deps",
    "vectorization_library_copts",
    "vectorization_linkopts",
    "vectorization_sleef_deps",
    "vectorization_svml_deps",
    "vectorization_svml_hdrs_extra",
)

package(default_visibility = ["//visibility:public"])

_VEC_TEST = ["Testing/**"]
# CMake: exclude svml.h from the target when VECTORIZATION_ENABLE_SVML is OFF; re-add via hdrs select when ON.
_VEC_SVML_H = "backend/cpu/avx/svml.h"

# Metal GPU backend support (mirrors CMakeLists.txt:690-720's "Metal GPU backend" block).

# Embeds kernels.metal as a C++ string literal via @METAL_KERNEL_SOURCE@ substitution
# into metal_kernels_source.h.in -- the same substitution CMake's configure_file() does.
# A dedicated script (not python3 -c) so Windows cmd.exe does not split the command.
genrule(
    name = "metal_kernels_source_h",
    srcs = [
        "backend/gpu/metal/metal_kernels_source.h.in",
        "backend/gpu/metal/kernels.metal",
    ],
    outs = ["backend/gpu/metal/metal_kernels_source.h"],
    cmd = "python3 $(location //bazel:embed_metal_kernel.py) $(location backend/gpu/metal/metal_kernels_source.h.in) $(location backend/gpu/metal/kernels.metal) $@",
    cmd_bat = "python $(location //bazel:embed_metal_kernel.py) $(location backend/gpu/metal/metal_kernels_source.h.in) $(location backend/gpu/metal/kernels.metal) $@",
    tools = ["//bazel:embed_metal_kernel.py"],
)

# .mm -> .cc rename workaround for cc_library's lack of native .mm support -- see the matching
# comment in Library/Memory/BUILD.bazel for the full rationale.
copy_file(
    name = "metal_dispatch_objcxx",
    src = "backend/gpu/metal/metal_dispatch.mm",
    out = "backend/gpu/metal/metal_dispatch_mm.cc",
)

# Isolates the -x objective-c++ -fobjc-arc copts to just this one translation unit rather than
# applying them to the whole vectorization_lib target -- see the matching cc_library split
# (memory_metal_objcxx) and comment in Library/Memory/BUILD.bazel for the full rationale.
cc_library(
    name = "vectorization_metal_objcxx",
    srcs = select({
        "//bazel:vectorization_enable_metal": [":metal_dispatch_objcxx"],
        "//conditions:default": [],
    }),
    hdrs = select({
        "//bazel:vectorization_enable_metal": glob(
            [
                "backend/gpu/metal/*.h",
                "common/*.h",
                # metal_dispatch.mm uses reduce_identity; this target does not
                # depend on vectorization_lib (that would be a cycle).
                "expressions/reduce_op.h",
            ],
            allow_empty = True,
        ) + [":metal_kernels_source_h"],
        "//conditions:default": [],
    }),
    copts = vectorization_library_copts() + select({
        "//bazel:vectorization_enable_metal": ["-x", "objective-c++", "-fobjc-arc"],
        "//conditions:default": [],
    }),
    defines = vectorization_defines(),
    includes = ["."],
    deps = [
        "@logging//:Logging",
        "//Library/Memory:Memory",
        "@profiler//:Profiler",
    ],
    visibility = ["//Library/Vectorization:__pkg__"],
)

cc_library(
    name = "vectorization_lib",
    srcs = select({
        "//bazel:vectorization_type_no": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/sse/**",
                "backend/cpu/avx/**",
                "backend/cpu/avx512/**",
                "backend/cpu/neon/**",
                "backend/cpu/sve/**",
            ],
            allow_empty = True,
        ),
        "//bazel:vectorization_type_sse": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/avx/**",
                "backend/cpu/avx512/**",
            ],
            allow_empty = True,
        ),
        "//bazel:vectorization_type_avx": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/sse/**",
                "backend/cpu/avx512/**",
            ],
            allow_empty = True,
        ),
        "//bazel:vectorization_type_avx512": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/sse/**",
                "backend/cpu/avx/**",
            ],
            allow_empty = True,
        ),
        "//bazel:vectorization_type_neon": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/sse/**",
                "backend/cpu/avx/**",
                "backend/cpu/avx512/**",
                "backend/cpu/sve/**",
            ],
            allow_empty = True,
        ),
        "//bazel:vectorization_type_sve": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/sse/**",
                "backend/cpu/avx/**",
                "backend/cpu/avx512/**",
            ],
            allow_empty = True,
        ),
        "//conditions:default": glob(
            ["**/*.cpp", "**/*.cxx"],
            exclude = _VEC_TEST + [
                "backend/cpu/sse/**",
                "backend/cpu/avx512/**",
            ],
            allow_empty = True,
        ),
    }),
    hdrs =
        select({
            "//bazel:vectorization_type_no": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                # Keep backend/simd.h (empty simd<T> + include dispatcher). Drop
                # ISA-specific and GPU backend headers that type=no never includes.
                exclude = _VEC_TEST + [
                    "backend/cpu/**",
                    "backend/gpu/**",
                ],
                allow_empty = True,
            ),
            "//bazel:vectorization_type_sse": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/avx/**",
                    "backend/cpu/avx512/**",
                ],
                allow_empty = True,
            ),
            "//bazel:vectorization_type_avx": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/sse/**",
                    "backend/cpu/avx512/**",
                    _VEC_SVML_H,
                ],
                allow_empty = True,
            ),
            "//bazel:vectorization_type_avx2": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/sse/**",
                    "backend/cpu/avx512/**",
                    _VEC_SVML_H,
                ],
                allow_empty = True,
            ),
            "//bazel:vectorization_type_avx512": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/sse/**",
                    "backend/cpu/avx/**",
                ],
                allow_empty = True,
            ),
            "//bazel:vectorization_type_neon": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/sse/**",
                    "backend/cpu/avx/**",
                    "backend/cpu/avx512/**",
                    "backend/cpu/sve/**",
                    _VEC_SVML_H,
                ],
                allow_empty = True,
            ),
            "//bazel:vectorization_type_sve": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/sse/**",
                    "backend/cpu/avx/**",
                    "backend/cpu/avx512/**",
                    _VEC_SVML_H,
                ],
                allow_empty = True,
            ),
            "//conditions:default": glob(
                [
                    "**/*.h",
                    "**/*.inl",
                    "**/*.hxx",
                ],
                exclude = _VEC_TEST + [
                    "backend/cpu/sse/**",
                    "backend/cpu/avx512/**",
                    _VEC_SVML_H,
                ],
                allow_empty = True,
            ),
        }) + vectorization_svml_hdrs_extra(_VEC_SVML_H),
    copts = vectorization_library_copts(),
    defines = vectorization_defines() + select({
        "//bazel:shared_libs": [
            "VECTORIZATION_SHARED_DEFINE",
            "VECTORIZATION_BUILDING_DLL",
        ],
        "//conditions:default": ["VECTORIZATION_STATIC_DEFINE"],
    }),
    includes = [
        ".",
        "Testing",
    ],
    linkopts = vectorization_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = [
        "@logging//:Logging",
        "//Library/Memory:Memory",
        "@profiler//:Profiler",
    ] + vectorization_svml_deps() + vectorization_sleef_deps() + vectorization_gpu_deps() + select({
        "//bazel:vectorization_enable_metal": [":vectorization_metal_objcxx"],
        "//conditions:default": [],
    }),
    visibility = ["//Library/Vectorization:__pkg__"],
)

cc_library(
    name = "Vectorization",
    deps = [":vectorization_lib"],
    visibility = ["//visibility:public"],
)

# Test support headers — VectorizationTest.h.in is included by VectorizationTest.h at compile time.
cc_library(
    name = "vectorization_test_hdrs",
    hdrs = glob(["Testing/*.h"], allow_empty = True),
    textual_hdrs = glob(["Testing/*.h.in"], allow_empty = True),
    includes = ["Testing"],
    deps = [":Vectorization"],
    visibility = ["//Library/Vectorization:__pkg__"],
)

# metal_device_probe.mm: tiny Objective-C++ shim TestTensorGpu.cpp calls into for a Metal
# device-count query (see Testing/Cxx/CMakeLists.txt's "*.mm (not just Test*.mm)" comment).
copy_file(
    name = "metal_device_probe_objcxx",
    src = "Testing/Cxx/metal_device_probe.mm",
    out = "Testing/Cxx/metal_device_probe_mm.cc",
)

copy_file(
    name = "test_metal_dispatch_objcxx",
    src = "Testing/Cxx/TestMetalDispatch.mm",
    out = "Testing/Cxx/TestMetalDispatch_mm.cc",
)

# Isolates -x objective-c++ -fobjc-arc to just these translation units -- see
# vectorization_metal_objcxx above / Library/Memory/BUILD.bazel for the full rationale.
# alwayslink: TestMetalDispatch registers Google Test cases via static TEST macros.
cc_library(
    name = "vectorization_test_metal_objcxx",
    srcs = select({
        "//bazel:vectorization_enable_metal": [
            ":metal_device_probe_objcxx",
            ":test_metal_dispatch_objcxx",
        ],
        "//conditions:default": [],
    }),
    alwayslink = True,
    copts = vectorization_copts() + select({
        "//bazel:vectorization_enable_metal": ["-x", "objective-c++", "-fobjc-arc"],
        "//conditions:default": [],
    }),
    defines = [
        "XSIGMA_HAS_GTEST=1",
        "XSIGMA_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
    ],
    includes = [
        "Testing/Cxx",
        ".",
        "Testing",
    ],
    deps = [
        ":Vectorization",
        ":vectorization_test_hdrs",
        "@com_google_googletest//:gtest",
    ],
    visibility = ["//Library/Vectorization:__pkg__"],
)

# Mirrors CMake VectorizationCxxTests (Test*.cpp only; benchmarks are separate).
cc_test(
    name = "VectorizationCxxTests",
    size = "large",
    timeout = "long",
    srcs = glob(
        ["Testing/Cxx/Test*.cpp"],
        # TestTensorGpu.cpp: CMake processes this via nvcc/hipcc (LANGUAGE CUDA/HIP) to
        # instantiate GPU expression-template kernels (Testing/Cxx/CMakeLists.txt:32-38,
        # 57-63) -- Bazel has no device-language compilation support anywhere in this
        # project (same class of gap as Core's CudaEnzymeADTest.cu, see
        # Docs/BAZEL_USER_GUIDE.md); compiling it as plain C++ under CUDA/HIP would produce
        # a binary missing the GPU kernels. Statically excluded here, added back below only
        # when neither CUDA nor HIP is selected -- under Metal (and no GPU backend) it stays
        # included, since CMake treats it as "ordinary host C++" there too (no LANGUAGE tag
        # needed, see the file's own header comment).
        exclude = ["Testing/Cxx/TestTensorGpu.cpp"],
        allow_empty = True,
    ) + select({
        "//bazel:vectorization_enable_cuda": [],
        "//bazel:vectorization_enable_hip": [],
        "//conditions:default": glob(["Testing/Cxx/TestTensorGpu.cpp"], allow_empty = True),
    }),
    copts = vectorization_copts(),
    defines = vectorization_defines() + [
        "XSIGMA_HAS_GTEST=1",
        "XSIGMA_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
    ],
    includes = [
        "Testing/Cxx",
        ".",
        "Testing",
    ],
    linkopts = vectorization_linkopts(),
    target_compatible_with = selects.with_or({
        (
            "//bazel:disable_gtest",
            "//bazel:vectorization_disable_testing",
        ): ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":vectorization_test_hdrs",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ] + select({
        "//bazel:vectorization_enable_metal": [":vectorization_test_metal_objcxx"],
        "//conditions:default": [],
    }),
)

# CMake: BenchmarkSimd*.cpp → benchmark_simd* when VECTORIZATION_ENABLE_BENCHMARK and type != no.

_SIMD_BENCH_DEPS = [
    ":Vectorization",
    "@com_google_benchmark//:benchmark",
    "@com_google_benchmark//:benchmark_main",
]

_SIMD_BENCH_COMPATIBLE = selects.with_or({
    (
        "//bazel:vectorization_disable_benchmark",
        "//bazel:vectorization_type_no",
    ): ["@platforms//:incompatible"],
    "//conditions:default": [],
})

[
    cc_binary(
        name = "benchmark_simdunary" + _suffix.lower(),
        srcs = [
            "Testing/Cxx/BenchmarkSimdUnary" + _suffix + ".cpp",
            "Testing/Cxx/BenchmarkSimdUnaryShared.h",
        ],
        copts = vectorization_copts(),
        defines = vectorization_defines(),
        includes = [
            "Testing/Cxx",
            ".",
            "Testing",
        ],
        linkopts = vectorization_linkopts(),
        target_compatible_with = _SIMD_BENCH_COMPATIBLE,
        deps = _SIMD_BENCH_DEPS,
    )
    for _suffix in ["CbrtNeg", "Hyperbolic", "SqrtLog", "Trig"]
]

cc_binary(
